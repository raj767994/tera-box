# ============================================================
# TeraBox Bot — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env to version control!
# ============================================================

# Your Telegram bot token from @BotFather
BOT_TOKEN=123456789:ABCDefGhIJKLmnopQRSTuvwxyz

# Your own Telegram user ID (get it from @userinfobot)
# This is the ONLY account with owner/admin powers.
OWNER_ID=987654321

# Rate limiting (per user)
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW=60

# Directories
DOWNLOAD_DIR=downloads
CACHE_DIR=cache

# Telegram upload limit in bytes (50MB default for cloud API)
TELEGRAM_FILE_LIMIT=52428800

# yt-dlp settings
YTDLP_RETRIES=5
YTDLP_CONCURRENT_FRAGS=4
